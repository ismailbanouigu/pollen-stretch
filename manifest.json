{
	"manifest_version": 3,
	"name": "Pollen Stretch",
	"description": "Click a sentence on any page to grow it in place with Pollinations AI.",
	"version": "1.0.0",
	"permissions": ["activeTab", "storage"],
	"host_permissions": [
		"https://enter.pollinations.ai/*",
		"https://gen.pollinations.ai/*"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Pollen Stretch",
		"default_popup": "popup/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content/content.js"],
			"css": ["content/content.css"],
			"run_at": "document_idle"
		}
	],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+S",
				"mac": "Alt+Shift+S"
			},
			"description": "Open Pollen Stretch"
		}
	}
}
